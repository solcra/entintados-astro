---
export interface Props {
  title?: string;
  description?: string;
  image?: string;
  url?: string;
}
import { Image } from 'astro:assets';
const { title, image, url ,description } = Astro.props;
---
<a href={url} class="block hover:scale-105 transition-transform duration-300">
  <div class="bg-white rounded-2xl shadow-md overflow-hidden">
    <Image 
      src={image || ""}
      alt={title || ""}  
      class="w-full aspect-square object-cover"
      width={394.66} height={394.66}
    />
    <h2 class="text-xl font-semibold text-center py-4">{title}</h2>
    <div class="px-4 py-2 bg-teal-700 text-white shadow transition text-center">
      ¡Lo quiero!
    </div>
  </div>
</a>
