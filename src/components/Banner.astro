---
export interface Props {
  url_imagen?: string;
  title?: string;
}

const { url_imagen, title } = Astro.props;
---
<section class="relative w-full">
  <!-- Imagen -->
  <img 
    src={url_imagen}
    alt= {title || "Título del Banner"}
    class="w-full h-auto object-cover"
  />

  <!-- Texto a la derecha ocupando 50% -->
  <div class="absolute inset-0 flex items-center justify-end">
    <div class="w-1/2 flex items-center justify-center p-5">
      <h1 class="text-4xl md:text-6xl text-black text-center leading-tight"
        set:html={title || "Título del Banner"}>
      </h1>
    </div>
  </div>
</section>