---
import '../styles/global.css';
// Component Imports
import Header from '../components/Header.astro';
import Hade from '../components/Head.astro';
import Slider from '../components/Slider.astro';
import Testimonios from '../components/Testimonios.astro';
import LomasVendido from '../components/LomasVendido.astro';
import "swiper/css";

// const allPosts = await Astro.glob('../content/productos/*.md')


import { getCollection } from 'astro:content';
const allPosts = await getCollection('productos');
const postsJson = JSON.stringify(
  allPosts.map(post => ({
    slug: post.slug,
    title: post.data.title,
    image: post.data.image,
	rutaUrl: post.data.rutaUrl,
  }))
);

---

<html lang="es-CO">
	<Hade 
		title="Entintados"
		titleSeo="Compra termos y mugs con diseños artísticos exclusivos"
		descripcionSeo="Personaliza tu rutina con termos y mugs ilustrados en tinta. Animales, naturaleza y arte original para regalar o disfrutar cada día."
		image='images/entintados.jpg'
		>
	</Head>
	<body class="overflow-x-hidden m-0 p-0 min-h-screen">
		<Header></Header>
		<Slider client:idle>			
		</Slider>
		<section class="w-full flex justify-center items-center py-10 md:py-20 bg-white">
			<div class="w-[90%] md:w-1/2 text-center px-5 mx-auto">
				<p class="text-2xl md:text-4xl font-light text-gray-900 leading-snug">
					<span class="block text-3xl md:text-5xl font-bold mb-4">¡Hola!</span>
					Mi nombre es Catherine, soy la mente creativa detrás de 
					<span class="italic">Entintados</span>, y estoy lista para plasmar 
					tus ideas en un termo único!
				</p>
			</div>
		</section>
		<LomasVendido></LomasVendido>
		<section class="max-w-7xl mx-auto px-4 py-10">
			<h2 class="text-3xl font-bold text-center">Nuestros Productos</h2>
			<section class="w-full flex justify-center items-center py-10 md:py-10 bg-white">
				<div class="w-[95%] md:w-3/4 text-center px-5 mx-auto">
					<p class="text-lg md:text-2xl font-light text-gray-900 leading-relaxed max-w-3xl mx-auto">
					Cada pieza de Entintados lleva la pasión y el amor por crear momentos únicos. 
					No solo compras un producto, te llevas una experiencia artística que acompaña tu día a día.
					</p>
				</div>
			</section>
			<div id="productos" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8"></div>

			<script type="application/json" id="posts-data" set:html={postsJson}></script>
			<script>
				// 1. Obtenemos los posts desde el <script type="application/json">
				const allPosts = JSON.parse(document.getElementById('posts-data').textContent);

				// 2. Función para mezclar aleatoriamente
				function shuffleArray(array) {
					return array
					.map(item => ({ item, sort: Math.random() }))
					.sort((a, b) => a.sort - b.sort)
					.map(({ item }) => item);
				}

				// 3. Tomamos solo 3 productos aleatorios
				const randomPosts = shuffleArray(allPosts).slice(0, 3);

				// 4. Contenedor donde vamos a renderizar
				const container = document.getElementById('productos');

				// 5. Generamos el HTML de cada tarjeta
				randomPosts.forEach(item => {
					const html = `
					<a href="/productos/${item.slug}/" class="block hover:scale-105 transition-transform duration-300">
						<div class="bg-white rounded-2xl shadow-md overflow-hidden">
						<img 
							src="/images/productos/${item.rutaUrl}/${item.image}" 
							alt="${item.title}" 
							class="w-full aspect-square object-cover"
						>
						<h2 class="text-xl font-semibold text-center py-4">${item.title}</h2>
						<div class="px-4 py-2 bg-teal-700 text-white shadow transition text-center">
							¡Lo quiero!
						</div>
						</div>
					</a>
					`;
					container.insertAdjacentHTML('beforeend', html);
				});
			</script>

			<div class="text-center mt-10">
				<a href="/productos" class="bg-teal-700 text-white px-6 py-3 rounded-lg shadow-md hover:bg-teal-800 transition">
					Ver todos
				</a>
			</div>
		</section>
		<Testimonios></Testimonios>

	</body>
</html>
