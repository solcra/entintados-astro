---
import '../styles/global.css';
// Component Imports
import Button from '../components/Button.astro';
import Header from '../components/Header.astro';
import CardProducto from '../components/CardProducto.astro';
import Banner from '../components/Banner.astro';
import Hade from '../components/Head.astro';

const allPosts = await Astro.glob('../content/productos/*.md')

// Full Astro Component Syntax:
// https://docs.astro.build/basics/astro-components/
---

<html lang="es-CO">
	<Hade 
		title="Entintados"
		titleSeo="Compra termos y mugs con diseños artísticos exclusivos"
		description="Personaliza tu rutina con termos y mugs ilustrados en tinta. Animales, naturaleza y arte original para regalar o disfrutar cada día."
		image='/images/entintados.jpg'
		>
	</Head>
	<body class="overflow-x-hidden m-0 p-0 min-h-screen">
		<Header></Header>
		<Banner
			url_imagen="/images/banner.jpg"
			title="<span>Diseño con identidad:</span> <br><span class='font-bold'>arte que se vive</span>">
		</Banner>
		<section class="w-full flex justify-center items-center py-10 md:py-20 bg-white">
			<div class="w-[90%] md:w-1/2 text-center px-5 mx-auto">
				<p class="text-2xl md:text-4xl font-light text-gray-900 leading-snug">
					<span class="block text-3xl md:text-5xl font-bold mb-4">¡Hola!</span>
					Mi nombre es Catherine, soy la mente creativa detrás de 
					<span class="italic">Entintados</span>, y estoy lista para plasmar 
					tus ideas en un termo único!
				</p>
			</div>
		</section>
		<section class="max-w-7xl mx-auto px-4 py-10">
			<h2 class="text-3xl font-bold text-center mb-8">Nuestros Productos</h2>
			
			<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
				
				{allPosts.map((item) => (
					
					<CardProducto 
						title={item?.frontmatter?.title}
						image={item?.frontmatter?.image}
					/>
				))}
			</div>
		</section>
	</body>
</html>
