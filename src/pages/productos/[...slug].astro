---
import '../../styles/global.css';
import { getCollection, render } from 'astro:content';
import Hade from '../../components/Head.astro';
import ProductSelector from '../../components/ProductSelector.vue';
import Header from '../../components/Header.astro';

export async function getStaticPaths() {
  const productos = await getCollection('productos');
  return productos.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const {
  title,
  description,
  image,
  rutaUrl,
  titleSeo,
  descripcionSeo,
  order,
} = entry.data;

---
<html lang="es-CO">
	<Hade 
		title={title}
		titleSeo={titleSeo }
    descripcionSeo={descripcionSeo}
		image=`images/productos/${rutaUrl}/${image}`
		>
	</Head>
	<body class="overflow-x-hidden m-0 p-0 min-h-screen">
    <Header></Header>
      <ProductSelector
        client:load
        titulo={title}
        descripcion={description}
        rutaUrl={rutaUrl}
        image={image}
      ><Content /></ProductSelector>
  </body>
</html>